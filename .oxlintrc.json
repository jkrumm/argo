{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "react-perf",
    "typescript",
    "import",
    "unicorn",
    "jsx-a11y",
    "promise",
    "oxc",
    "jsdoc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-var": "error",
    "eqeqeq": "error",
    "no-console": "warn",
    "no-shadow": "off",
    "react/rules-of-hooks": "error",
    "react/jsx-key": "error",
    "react/react-in-jsx-scope": "off",
    "typescript/no-explicit-any": "warn",
    "import/no-duplicates": "error",
    "import/no-unassigned-import": "off"
  },
  "ignorePatterns": ["apps/api/src/generated/**"],
  "overrides": [
    {
      "files": ["apps/dashboard/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "antd",
                "message": "Use Mantine — antd was removed in the migration."
              },
              {
                "name": "@ant-design/icons",
                "message": "Use @tabler/icons-react."
              },
              {
                "name": "@refinedev/core",
                "message": "Refine was removed in the migration."
              },
              {
                "name": "@refinedev/antd",
                "message": "Refine was removed in the migration."
              },
              {
                "name": "react-router",
                "message": "Use @tanstack/react-router."
              },
              {
                "name": "react-router-dom",
                "message": "Use @tanstack/react-router."
              },
              {
                "name": "@visx/tooltip",
                "message": "Use ChartTooltip + TooltipHeader/Row/Body from src/charts/primitives."
              }
            ],
            "patterns": [
              {
                "group": ["@refinedev/*"],
                "message": "Refine was removed in the migration."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/charts/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@mantine/core",
                "message": "packages/charts must be theme-agnostic — no Mantine imports allowed."
              },
              {
                "name": "@mantine/hooks",
                "message": "packages/charts must be theme-agnostic — no Mantine imports allowed."
              }
            ],
            "patterns": [
              {
                "group": ["@mantine/*"],
                "message": "packages/charts must be theme-agnostic — no Mantine imports allowed."
              },
              {
                "group": ["apps/*"],
                "message": "packages/charts must not import from apps/."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/charts/src/kinds/**"],
      "rules": {
        "no-underscore-dangle": "off"
      }
    },
    {
      "files": ["apps/api/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "bun:sqlite",
                "message": "Argo uses Postgres — import from drizzle-orm/postgres-js."
              },
              {
                "name": "drizzle-orm/bun-sqlite",
                "message": "Argo uses Postgres — import from drizzle-orm/postgres-js."
              }
            ]
          }
        ]
      }
    }
  ]
}
