{
  "name": "@argo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --hot src/index.ts",
    "test": "bun test",
    "test:unit": "DATABASE_URL=postgres://localhost:5432/placeholder API_SECRET=ci-placeholder bun test --timeout 30000 src/env.test.ts src/otlp-headers.test.ts src/serve-dashboard.test.ts src/telemetry.test.ts src/clients src/cron src/lib src/routes/astro.test.ts src/routes/calendar.test.ts src/routes/finance.test.ts src/routes/jira.test.ts src/routes/m365.test.ts src/routes/marine.test.ts src/routes/models.test.ts src/routes/openapi-auth.test.ts src/routes/usage.test.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "gen:astro-sites": "bun run scripts/gen-astro-sites.ts",
    "gen:garmin": "bun run scripts/gen-garmin.ts",
    "m365:auth": "bun run scripts/m365-bootstrap.ts",
    "m365:auth:prod": "bun run scripts/m365-bootstrap.ts --target=prod"
  },
  "dependencies": {
    "@elysiajs/cors": "^1",
    "@elysiajs/openapi": "^1.4.16",
    "@elysiajs/opentelemetry": "^1.4.11",
    "@kubiks/otel-drizzle": "^2.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "astronomy-engine": "2.1.19",
    "croner": "^9",
    "drizzle-orm": "^0.38.0",
    "elysia": "^1.4.30",
    "postgres": "^3",
    "socket.io-client": "^4.8.3",
    "zod": "^4"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.93.1",
    "bun-types": "^1.4.2",
    "drizzle-kit": "^0.29.0",
    "typescript": "^5"
  }
}
