{
  "name": "argo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "op run --account tkrumm --env-file=apps/api/.env.local.tpl --env-file=apps/dashboard/.env.local.tpl -- ./scripts/dev.sh",
    "dev:prod-api": "op run --account tkrumm --env-file=apps/dashboard/.env.local.tpl -- ./scripts/dev-prod-api.sh",
    "db:migrate": "op run --account tkrumm --env-file=apps/api/.env.local.tpl -- ./scripts/db-migrate.sh",
    "db:sync": "make -C ../vps pg-sync-schema SCHEMA=argo ENV=dev",
    "test:api": "op run --account tkrumm --env-file=apps/api/.env.local.tpl -- ./scripts/test.sh",
    "m365:auth": "bun run --cwd apps/api m365:auth",
    "m365:auth:prod": "op run --account tkrumm --env-file=apps/api/.env.local.tpl -- bun run --cwd apps/api m365:auth:prod",
    "google:auth": "printf 'http://localhost:4040/oauth/google/init' | pbcopy && echo 'http://localhost:4040/oauth/google/init' && echo 'Copied to clipboard — paste into a browser to authorize.'",
    "google:auth:prod": "printf 'https://argo.jkrumm.com/api/oauth/google/init' | pbcopy && echo 'https://argo.jkrumm.com/api/oauth/google/init' && echo 'Copied to clipboard — paste into a browser to authorize.'",
    "lint": "oxlint . && bunx basalt check-theme",
    "lint:fix": "oxlint --fix .",
    "check:theme": "bunx basalt check-theme",
    "check:design": "npx -y @google/design.md@0.2.0 lint DESIGN.md",
    "format": "oxfmt 'apps/**' 'packages/**' '!**/generated/**' '!**/dist/**' --write",
    "format:check": "oxfmt 'apps/**' 'packages/**' '!**/generated/**' '!**/dist/**' --check"
  },
  "devDependencies": {
    "basalt-ui": "file:../basalt-ui/packages/basalt-ui",
    "concurrently": "^9.2.1",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0"
  },
  "basalt": {
    "roots": [
      "apps/dashboard/src"
    ],
    "exempt": [
      "apps/dashboard/src/lib/series.ts"
    ],
    "rawSurface": false,
    "rawHtmlLayout": false,
    "inlineSpacing": false,
    "inlineDisplay": false,
    "unframedChart": false,
    "chartMissingAriaLabel": false
  }
}
