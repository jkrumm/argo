{
  "name": "argo",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "secrets-run run --env-file=apps/api/.env.local.tpl --env-file=apps/dashboard/.env.local.tpl -- ./scripts/dev.sh",
    "dev:prod-api": "op run --account tkrumm --env-file=apps/dashboard/.env.local.tpl -- ./scripts/dev-prod-api.sh",
    "db:migrate": "secrets-run run --env-file=apps/api/.env.local.tpl -- ./scripts/db-migrate.sh",
    "db:sync": "make db-sync",
    "test:api": "./scripts/test.sh",
    "m365:auth": "bun run --cwd apps/api m365:auth",
    "m365:auth:prod": "op run --account tkrumm --env-file=apps/api/.env.local.tpl -- bun run --cwd apps/api m365:auth:prod",
    "google:auth": "printf 'http://localhost:4040/oauth/google/init' | pbcopy && echo 'http://localhost:4040/oauth/google/init' && echo 'Copied to clipboard — paste into a browser to authorize.'",
    "google:auth:prod": "printf 'https://argo.jkrumm.com/api/oauth/google/init' | pbcopy && echo 'https://argo.jkrumm.com/api/oauth/google/init' && echo 'Copied to clipboard — paste into a browser to authorize.'",
    "lint": "oxlint . && ./node_modules/.bin/basalt-ui check-theme",
    "lint:fix": "oxlint --fix .",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "verify:pages": "bun scripts/verify-pages.ts",
    "check:theme": "./node_modules/.bin/basalt-ui check-theme",
    "check:design": "npx -y @google/design.md@0.2.0 lint DESIGN.md",
    "format": "oxfmt 'apps/**' 'packages/**' '!**/generated/**' '!**/dist/**' --write",
    "format:check": "oxfmt 'apps/**' 'packages/**' '!**/generated/**' '!**/dist/**' --check"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "basalt-ui": "2.29.0",
    "chrome-launcher": "1.2.3",
    "concurrently": "^10.0.7",
    "lefthook": "^2.2.2",
    "lighthouse": "13.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright-core": "1.65.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "maplibre-gl": "6.10.0",
    "solid-js": "^1.9.19",
    "ws": "^8.22.0",
    "js-yaml": "^4.3.2",
    "protobufjs": "^7.6.5",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0"
  },
  "basalt": {
    "roots": [
      "apps/dashboard/src"
    ],
    "exempt": [
      "apps/dashboard/src/lib/series.ts"
    ]
  }
}
